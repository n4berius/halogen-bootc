# Everything this image pins. Update here, then rebuild.
FEDORA_BOOTC_IMAGE=quay.io/fedora/fedora-bootc:45

HALOGEN_VERSION=0.18.23
# The OS image is published as ghcr.io/n4berius/halogen-flash-bootc:<HALOGEN_VERSION>.
# Leave empty to have scripts/build.sh resolve the tag to a digest at build time.
# Either way, the image only ever runs the digest it was built with.
HALOGEN_DIGEST=sha256:b53c96edc042b1d9570cda2771c5002527f94d6aca0c8704a4475aa621d355ff

# Commit of peonist-ai/halogen-flash-server that matches HALOGEN_VERSION.
HALOGEN_SOURCE_COMMIT=9c7a58734841b7b9b9a58889540a3cbf7b5cc8b1
HALOGEN_CLOCK_SHA256=0dbd47c15f1002e0a8997ec7070e96f3e009125068eab8eccbbd49424a594f5a
HALOGEN_LICENSE_SHA256=58f970ff94fb67d41146f1551a83fb208b5aee4d087224e2097b92850404f53b
HALOGEN_NOTICES_SHA256=4c74410dc302b0ff9f0d7b16353295002301d24d67a449104ba3df13e5fb11fc

HALOGEN_WEIGHTS_REPO=peonist-ai/halogen-qwen3.8-flash-next
# Set to a commit once you have tested one. The image's verify mode checks the checkpoint either way.
HALOGEN_WEIGHTS_REVISION=main

# Debian 13, the same base as the Halogen image, so XRT matches its C runtime.
DEBIAN_IMAGE=docker.io/library/debian@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
XRT_MIN_VERSION=2.20
