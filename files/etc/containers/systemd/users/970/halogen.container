[Unit]
Description=Halogen Flash server
Requires=halogen-fetch.service
After=halogen-fetch.service
# An unclean GPU exit can need a reboot, so do not restart forever.
StartLimitIntervalSec=900
StartLimitBurst=3

[Container]
Image=@HALOGEN_IMAGE@
Pull=never
ContainerName=halogen
# IPv4 only: Halogen listens on IPv4, so an IPv6 forward (localhost is ::1 first) would
# accept the connection and then reset it. With this, clients fall back to 127.0.0.1.
PublishPort=0.0.0.0:8731:8731
AddDevice=/dev/kfd
AddDevice=/dev/dri
Ulimit=memlock=-1:-1
PodmanArgs=--ipc=host --group-add=keep-groups
# Your approved settings, then the locked ones from the read-only OS.
EnvironmentFile=/run/user/970/halogen/effective.env
EnvironmentFile=/usr/share/halogen/locked.env
StopTimeout=60

# No download settings here: the server starts offline and read-only.
Volume=/srv/models:/models:ro
Volume=/srv/configs/api-key:/run/secrets/halogen-api-key:ro

[Service]
ExecStartPre=/usr/libexec/halogen/render-config
ExecStartPre=/usr/libexec/halogen/preflight
LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=30
TimeoutStartSec=900
TimeoutStopSec=90

[Install]
WantedBy=default.target
