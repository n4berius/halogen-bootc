#!/bin/bash
# Admin wrapper for the rootless Halogen service. Run with sudo.
set -euo pipefail
unit() { systemctl --user --machine=halogen@.host "$@"; }
# Files under /srv/configs and /srv/models belong to halogen, so read and write them as halogen, never as root:
# a link planted there then can't reach anything halogen couldn't already.
as_owner() { runuser -u halogen -- "$@"; }
configs="${HALOGEN_CONFIGS_DIR:-/srv/configs}"
# logs and fetch-logs keep following only on a terminal, so `| tail` and `> file` finish.
# An optional second argument sets how many lines to show (default 100).
follow=(); [ ! -t 1 ] || follow=(-f)
lines="${2:-100}"

case "${1:-status}" in
  status) unit --no-pager status halogen-fetch.service halogen.service || true ;;
  start|stop|restart) unit "$1" halogen.service ;;
  logs) exec journalctl --no-pager "${follow[@]}" -n "$lines" _SYSTEMD_USER_UNIT=halogen.service + _SYSTEMD_USER_UNIT=halogen-fetch.service ;;
  fetch-logs) exec journalctl --no-pager "${follow[@]}" -n "$lines" _SYSTEMD_USER_UNIT=halogen-fetch.service ;;
  doctor)
    # Runs under the service manager, so it sees the service's real limits.
    systemd-run --machine=halogen@.host --user --pipe --wait --quiet /usr/libexec/halogen/render-config >/dev/null
    # While Halogen runs, the GTT it holds is expected, not a leftover from a crash.
    running=0; ! unit --quiet is-active halogen.service || running=1
    systemd-run --machine=halogen@.host --user --pipe --wait --quiet \
      --setenv=HALOGEN_SERVER_RUNNING="$running" /usr/libexec/halogen/preflight
    ;;
  config)
    # Shows what Halogen receives. Ignored lines are explained above the list.
    systemd-run --machine=halogen@.host --user --pipe --wait --quiet /usr/libexec/halogen/render-config --show
    echo "--- locked ---"
    grep -v '^#' /usr/share/halogen/locked.env
    ;;
  selftest)
    # The beta checklist in one go. It changes nothing and prints nothing private.
    [ "$(id -u)" = 0 ] || { echo "Run it with sudo: sudo halogenctl selftest" >&2; exit 1; }
    exec /usr/libexec/halogen/selftest
    ;;
  api-key) as_owner cat "$configs/api-key"; echo ;;
  hf-token)
    # Store a Hugging Face read token for model downloads. It is never printed.
    token="$configs/hf-token"
    if [ "${2:-}" = --remove ]; then as_owner rm -f "$token"; echo "Removed the Hugging Face token."; exit 0; fi
    read -rsp "Hugging Face read token (from huggingface.co/settings/tokens): " value; echo
    case "$value" in
      hf_?*) ;;
      *) echo "That doesn't look like a token; they start with hf_. Nothing saved." >&2; exit 1 ;;
    esac
    # shellcheck disable=SC2016 # expanded by the halogen shell, from its arguments
    printf '%s\n' "$value" | as_owner sh -c 'umask 077; cat > "$1.new" && mv -f "$1.new" "$1"' sh "$token"
    echo "Saved. The next download uses it: sudo halogenctl restart"
    ;;
  model)
    # Your own NPU checkpoints under /srv/models/{decider,LFM,custom}.
    models="${HALOGEN_MODELS_DIR:-/srv/models}"
    as_halogen() { systemd-run --machine=halogen@.host --user --pipe --wait --quiet "$@"; }
    in_use() { as_halogen /usr/libexec/halogen/render-config --show 2>/dev/null | grep '^HALOGEN_NPU_MODELS=' | tr '=,' '\n' | sed 's/:fast$//' | grep -qxF -- "$1"; }
    case "${2:-list}" in
      pull)
        shift 2
        out="$(as_halogen /usr/libexec/halogen/model-pull "$@" | tee /dev/stderr)" || exit 1
        path="$(sed -n 's/^path=//p' <<< "$out")"
        [ -n "$path" ] || exit 1
        entry="$path"; ! grep -qx 'fast=1' <<< "$out" || entry="$path or $path:fast (faster, small quality cost)"
        echo
        echo "To serve it, add $entry to HALOGEN_NPU_MODELS in /srv/configs/halogen.env, for example:"
        if in_use "$path"; then echo "  It is already there. To use the new files: sudo halogenctl restart"; exit 0; fi
        line="$(as_owner grep '^HALOGEN_NPU_MODELS=' "$configs/halogen.env" | tail -n 1 || true)"
        new="HALOGEN_NPU_MODELS=${line#HALOGEN_NPU_MODELS=}"; new="${new%,}"
        [ "$new" = HALOGEN_NPU_MODELS= ] && new="$new$path" || new="$new,$path"
        echo "  $new"
        if [ -t 0 ]; then
          read -rp "Make that change and restart Halogen now? [y/N] " answer
          if [ "$answer" = y ] || [ "$answer" = Y ]; then
            # Replace the last HALOGEN_NPU_MODELS line, or add one, as halogen. awk takes the new
            # line as data (ENVIRON), so nothing in the file's old value can run as a command.
            # shellcheck disable=SC2016 # expanded by the halogen shell and awk
            NEW="$new" as_owner sh -c 'umask 027; f=$1
              n="$(grep -n "^HALOGEN_NPU_MODELS=" "$f" | tail -n 1 | cut -d: -f1)"
              N="${n:-0}" awk '"'"'NR == ENVIRON["N"] { print ENVIRON["NEW"]; done = 1; next } { print }
                END { if (!done) print ENVIRON["NEW"] }'"'"' "$f" > "$f.new" && mv -f "$f.new" "$f"' sh "$configs/halogen.env"
            unit restart halogen.service
            echo "Restarted. The first start converts the checkpoint for the NPU (about a minute)."
          fi
        fi
        ;;
      list)
        # What HALOGEN_NPU_MODELS serves now (one read, not one per model), without :fast.
        # Each read may fail (no npu folder yet, the halogen user's services down): still list.
        active="$( { as_halogen /usr/libexec/halogen/render-config --show 2>/dev/null || true; } | sed -n 's/^HALOGEN_NPU_MODELS=//p' | tr ',' '\n' | sed 's/:fast$//')"
        used() { if grep -qxF -- "$1" <<< "$active"; then echo yes; else echo no; fi; }
        echo "Your own checkpoints (/srv/models/decider, LFM and custom):"
        n=0
        for dir in "$models"/decider/*/ "$models"/LFM/*/ "$models"/custom/*/; do
          [ -d "$dir" ] || continue
          dir="${dir%/}"; rel="${dir#"$models"/}"
          [ "$n" -gt 0 ] || printf '  %-28s %-8s %-8s %s\n' NAME FOLDER SIZE "IN USE"
          printf '  %-28s %-8s %-8s %s\n' "$(basename "$dir")" "${rel%%/*}" "$(as_owner du -sh "$dir" | cut -f1)" "$(used "/models/$rel")"
          n=$((n + 1))
        done
        [ "$n" -gt 0 ] || echo "  None yet. Add one with: sudo halogenctl model pull <Hugging Face repo>"
        echo
        echo "Halogen's NPU models (/srv/models/npu):"
        names="$( { find "$models/npu" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null || true; } | sort)"
        if [ -z "$names" ]; then echo "  None downloaded yet."
        else
          printf '  %-28s %s\n' NAME "IN USE"
          while read -r name; do printf '  %-28s %s\n' "$name" "$(used "$name")"; done <<< "$names"
        fi
        echo
        echo "IN USE: listed in HALOGEN_NPU_MODELS (sudo halogenctl config). Halogen may add others itself,"
        echo "such as the agent guard's models."
        ;;
      remove)
        name="${3:-}"
        # Only a plain model name: anything else could reach outside the three folders.
        case "$name" in
          *[!A-Za-z0-9._-]*|.*|'') echo "usage: halogenctl model remove <name>, as sudo halogenctl model list shows it" >&2; exit 2 ;;
        esac
        dir=""
        for kind in decider LFM custom; do
          if [ -d "$models/$kind/$name" ]; then dir="$models/$kind/$name"; break; fi
        done
        [ -n "$dir" ] || { echo "No model called $name. See: sudo halogenctl model list" >&2; exit 1; }
        if in_use "/models/${dir#"$models"/}"; then
          echo "$name is in HALOGEN_NPU_MODELS. Take it out of /srv/configs/halogen.env first." >&2; exit 1
        fi
        [ -t 0 ] || { echo "Run this in a terminal: it asks before deleting." >&2; exit 1; }
        read -rp "Delete $dir ($(as_owner du -sh "$dir" | cut -f1))? [y/N] " answer
        [ "$answer" = y ] || [ "$answer" = Y ] || exit 0
        # As halogen: a folder link planted by a container must not let root delete through it.
        as_owner rm -rf -- "$dir" && echo "Deleted $name."
        ;;
      *) echo "usage: halogenctl model pull <hf-repo> [--revision <rev>] [--as <name>] | list | remove <name>" >&2; exit 2 ;;
    esac
    ;;
  *) echo "usage: halogenctl status|start|stop|restart|logs [lines]|fetch-logs [lines]|doctor|selftest|config|api-key|hf-token [--remove]|model pull|list|remove" >&2; exit 2 ;;
esac
