# Fixed by the OS image and read-only. Changing any of these needs a rebuild.
# HALOGEN_CHECKPOINT is not here: render-config sets it from halogenctl flash use (official by default).
HALOGEN_API_PORT=8731
HALOGEN_PORT=8730
HALOGEN_BIND=127.0.0.1
HALOGEN_API_KEY_FILE=/run/secrets/halogen-api-key
HALOGEN_NPU_VERIFY=1
HALOGEN_NPU_WITH_GPU=0
