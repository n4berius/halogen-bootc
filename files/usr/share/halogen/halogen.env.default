# Halogen settings for this machine. Copied once to /srv/configs/halogen.env.
# After editing, run: sudo halogenctl restart
# Changing the model list downloads any new models on that restart.

# Smaller models fit best. Each adds pinned host memory beside the Flash model.
HALOGEN_NPU_MODELS=decider-0.8b,qwen3-embedding-0.6b,qwen3-reranker-0.6b,qwen3guard-gen-0.6b,qwen3.5-2b

# 262144 keeps one full conversation resident and leaves room for the NPU models.
HALOGEN_KV_POOL_POSITIONS=262144

# Set to 1 to fetch and enable image input on the Flash model.
#HALOGEN_VISION_TOWER=1
