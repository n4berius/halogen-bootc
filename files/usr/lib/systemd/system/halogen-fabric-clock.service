# Same job as upstream's unit, with this image's path. Runs at boot and after resume.
[Unit]
Description=Hold the AMD GPU fabric clock at its top level (GPU and NPU together)
After=systemd-modules-load.service suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
Before=user@970.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/halogen/halogen-fabric-clock hold
# It only writes GPU clock settings in /sys, which ProtectSystem leaves writable. No
# ProtectKernelTunables or PrivateDevices: those would stop the clock hold itself.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
