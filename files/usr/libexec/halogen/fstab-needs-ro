#!/bin/bash
# Exit 0 when / in fstab lacks the "ro" option, so bootc-fstab-edit.service still has work to do.
# bootc 1.17 creates that unit at every boot while /etc/fstab says "Created by anaconda" and lacks
# its own "Updated by bootc-fstab-edit.service" marker. Our Anaconda already writes ro for /, so
# the marker never appears and the unit rewrote the same fstab at every boot (bootc-dev/bootc#2592),
# making every later mount warn "your fstab has been modified". Skip it while ro is there.
fstab="${1:-/etc/fstab}"
[ -r "$fstab" ] || exit 0
awk '$1 !~ /^#/ && $2 == "/" { n = split($4, o, ","); for (i = 1; i <= n; i++) if (o[i] == "ro") found = 1 }
     END { exit found ? 1 : 0 }' "$fstab"
