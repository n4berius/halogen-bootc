#!/bin/bash
# halOS status for people at the machine: one line on the console login screen, the same line
# plus the release in the SSH login message, and a one-time notice when Halogen first answers.
# Runs as root every 30 s from halos-status.timer. It changes nothing but files under /run.
#   console:  /run/issue.d/50-halos.issue (agetty shows /run/issue.d beside /etc/issue)
#   SSH:      /run/motd.d/50-halos        (pam_motd shows /run/motd.d)
set -uo pipefail
release="${HALOGEN_RELEASE_FILE:-/usr/share/halogen/release.env}"
models="${HALOGEN_MODELS_DIR:-/srv/models}"
run="${HALOS_RUN_DIR:-/run}"
port="${HALOGEN_API_PORT:-8731}"
needed_gib="${HALOGEN_MODELS_NEEDED_GIB:-125}"
# shellcheck source=/dev/null
. "$release"
state_dir="$run/halos"
mkdir -p "$state_dir" "$run/issue.d" "$run/motd.d" || exit 1

user_unit() { systemctl --user --machine=halogen@.host is-active "$1" 2>/dev/null | head -n 1; }
health() { curl -s -m 3 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/health" 2>/dev/null; }

# What Halogen is doing, in the words the login screen shows. "ready" ends in agetty's \4,
# which the console fills in with this machine's IPv4 address; the SSH message says the name.
fetch="$(user_unit halogen-fetch.service)"
server="$(user_unit halogen.service)"
code=""
case "$server" in active|activating|reloading) code="$(health)" ;; esac
if [ "$code" = 200 ]; then
  state=ready
elif [ "$fetch" = activating ]; then
  if [ -f "$models/.fetch-stamp" ]; then state="checking models"
  else
    # As halogen: root doesn't walk the halogen user's folders (see prepare).
    have="$(runuser -u halogen -- du -s --block-size=1G --exclude="$models/flash" "$models" 2>/dev/null | cut -f1)"
    pct=$(( ${have:-0} * 100 / needed_gib )); [ "$pct" -le 99 ] || pct=99
    state="downloading models ${pct}%"
  fi
elif [ "$fetch" = failed ]; then state="download failed: sudo halogenctl fetch-logs"
elif [ "$server" = active ] || [ "$server" = activating ] || [ "$server" = reloading ]; then state=starting
else state="stopped: sudo halogenctl logs"
fi

name="halOS ${HALOS_RELEASE:-} (${HALOGEN_VARIANT:-} edition)"
if [ "$state" = ready ]; then
  console="$name - ready: http://\\4:$port/v1"
  remote="$name - ready: http://$(hostname):$port/v1"
else
  console="$name - $state"; remote="$console"
fi

# Write a file only when its text changes, through a temporary file so a reader never sees half.
put() {
  [ "$(cat "$1" 2>/dev/null)" != "$2" ] || return 1
  printf '%s\n' "$2" > "$1.new" && mv -f "$1.new" "$1"
}
if put "$run/issue.d/50-halos.issue" "$console"; then
  # Redraw the login prompts already on screen, so the line is current without a keypress.
  agetty --reload 2>/dev/null || true
fi

# The SSH message adds what halosctl version says (release, channel, staged update), refreshed
# every 10 minutes because it asks bootc, and the free space for models.
version="$state_dir/version"
if [ ! -s "$version" ] || [ -n "$(find "$version" -mmin +10 2>/dev/null)" ]; then
  { halosctl version 2>/dev/null || true; } | grep -E '^(Channel|Halogen|Next boot|Rollback):' > "$version.new"
  mv -f "$version.new" "$version"
fi
free="$(df --output=avail --block-size=1G "$models" 2>/dev/null | tail -n 1 | tr -d ' ')"
motd="$remote
$(sed 's/^/  /' "$version")${free:+
  Models:    ${free} GiB free in /srv/models}
  More:      sudo halosctl version, sudo halogenctl status"
put "$run/motd.d/50-halos" "$motd" || true

# Tell logged-in terminals once per boot, the first time Halogen answers.
if [ "$state" = ready ] && [ ! -e "$state_dir/announced" ]; then
  : > "$state_dir/announced"
  wall "halOS: Halogen is ready at http://$(hostname):$port/v1" 2>/dev/null || true
fi
exit 0
